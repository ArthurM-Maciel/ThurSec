/* ThurSec TUI — elegant dark theme.
 * Palette: deep navy canvas, cool slate panels, cyan/teal accents, and
 * severity-coded highlights that match SEVERITY_COLORS in app.py.
 */

Screen {
    background: #0b0f1a;
    color: #e8ecf4;
}

Header {
    background: #10172a;
    color: #e8ecf4;
    text-style: bold;
}

Footer {
    background: #10172a;
    color: #8d99ae;
}

#body {
    height: 1fr;
}

/* --- sidebar ---------------------------------------------------------- */

#sidebar {
    width: 38;
    min-width: 30;
    background: #0e1424;
    border-right: tall #1c2740;
    padding: 1 1 0 2;
}

#sidebar-title {
    color: #5ad1a0;
    text-style: bold;
    padding: 0 0 1 0;
}

#module-list {
    height: 1fr;
}

.category-label {
    color: #4ea8de;
    text-style: bold;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick #4ea8de;
}

.module-group {
    background: transparent;
    border: none;
    padding: 0 0 0 1;
    height: auto;
    margin: 0 0 1 0;
}

.module-group > .selection-list--option {
    padding: 0 1;
}

.module-group:focus > .selection-list--option-highlighted {
    background: #1c2740;
}

SelectionList:focus {
    background: transparent;
}

.empty-hint {
    color: #7d8597;
    text-style: italic;
    padding: 1 0;
}

/* --- main panel ------------------------------------------------------- */

#main {
    width: 1fr;
    padding: 1 2;
}

#controls {
    height: 3;
    margin: 0 0 1 0;
}

#controls Input {
    width: 1fr;
    margin: 0 1 0 0;
    background: #121a2e;
    border: tall #1c2740;
    color: #e8ecf4;
}

#controls Input:focus {
    border: tall #4ea8de;
}

#controls Button {
    margin: 0 0 0 1;
    min-width: 12;
}

#scope-summary {
    height: auto;
    background: #121a2e;
    border: tall #1c2740;
    padding: 0 2;
    margin: 0 0 1 0;
}

#counts {
    height: auto;
    padding: 1 1;
    background: #0e1424;
    border: round #1c2740;
    margin: 0 0 1 0;
}

#findings {
    height: 1fr;
    background: #0e1424;
    border: round #1c2740;
    scrollbar-background: #0e1424;
    scrollbar-color: #1c2740;
}

#findings > .datatable--header {
    background: #121a2e;
    color: #8d99ae;
    text-style: bold;
}

#findings > .datatable--cursor {
    background: #1c2740;
}

#findings > .datatable--odd-row {
    background: #0c1120;
}

#activity-title {
    color: #8d99ae;
    text-style: bold;
    margin: 1 0 0 0;
}

#activity {
    height: 9;
    background: #0c1120;
    border: round #1c2740;
    padding: 0 1;
    scrollbar-background: #0c1120;
    scrollbar-color: #1c2740;
}
